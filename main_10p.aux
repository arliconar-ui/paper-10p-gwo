\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Closed-loop response on one unseen perturbed plant for manual, nominal-tuned and multi-plant-tuned gains (GWO, 200 iter.). (a,b) Tracking errors (mrad); (c,d) armature voltages ($\pm 24$~V limits). Nominal gains oscillate between saturation limits (10--30~mrad offset); manual gains avoid saturation but track poorly (up to 140~mrad); multi-plant gains stay within $\approx $10~mrad.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:loop}{{2}{5}{Closed-loop response on one unseen perturbed plant for manual, nominal-tuned and multi-plant-tuned gains (GWO, 200 iter.). (a,b) Tracking errors (mrad); (c,d) armature voltages ($\pm 24$~V limits). Nominal gains oscillate between saturation limits (10--30~mrad offset); manual gains avoid saturation but track poorly (up to 140~mrad); multi-plant gains stay within $\approx $10~mrad}{figure.caption.5}{}}
\newlabel{fig:loop@cref}{{[figure][2][]2}{[1][4][]5}{}{}{}}
